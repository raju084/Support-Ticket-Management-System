{
	"info": {
		"_postman_id": "support-ticket-api",
		"name": "Support Ticket Management API",
		"description": "Complete API collection for the Support Ticket Management System",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5000/api", "type": "string" },
		{ "key": "accessToken", "value": "", "type": "string" },
		{ "key": "ticketId", "value": "", "type": "string" },
		{ "key": "commentId", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken); }"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@example.com\",\n  \"password\": \"Test@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] } }
				},
				{
					"name": "Login (User)",
					"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken); }"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"User@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } }
				},
				{
					"name": "Login (Admin)",
					"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 200) { pm.collectionVariables.set('accessToken', pm.response.json().data.accessToken); }"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [], "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@support.com\",\n  \"password\": \"Admin@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] } }
				},
				{ "name": "Get Me", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } } },
				{ "name": "Update Profile", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Name\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] } } },
				{ "name": "Change Password", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"currentPassword\": \"User@123\",\n  \"newPassword\": \"NewPass@123\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/auth/change-password", "host": ["{{baseUrl}}"], "path": ["auth", "change-password"] } } },
				{ "name": "Logout", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] } } }
			]
		},
		{
			"name": "Tickets (User)",
			"item": [
				{
					"name": "Create Ticket",
					"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('ticketId', pm.response.json().data.ticket._id); }"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Cannot login to my account\",\n  \"description\": \"I have been trying to login for the past hour but keep getting an invalid credentials error.\",\n  \"category\": \"account\",\n  \"priority\": \"high\",\n  \"tags\": [\"login\", \"urgent\"]\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/tickets", "host": ["{{baseUrl}}"], "path": ["tickets"] } }
				},
				{ "name": "Get My Tickets", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/tickets?page=1&limit=10&status=open&sortBy=createdAt&sortOrder=desc", "host": ["{{baseUrl}}"], "path": ["tickets"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "10" }, { "key": "status", "value": "open" }, { "key": "sortBy", "value": "createdAt" }, { "key": "sortOrder", "value": "desc" }] } } },
				{ "name": "Get Ticket by ID", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}"] } } },
				{ "name": "Update Ticket", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated ticket title here\",\n  \"description\": \"Updated description with more details about the problem I am experiencing.\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}"] } } },
				{ "name": "Delete Ticket", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}"] } } },
				{ "name": "Get My Stats", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/tickets/stats/me", "host": ["{{baseUrl}}"], "path": ["tickets", "stats", "me"] } } }
			]
		},
		{
			"name": "Comments",
			"item": [
				{
					"name": "Add Comment",
					"event": [{ "listen": "test", "script": { "exec": ["if (pm.response.code === 201) { pm.collectionVariables.set('commentId', pm.response.json().data.comment._id); }"], "type": "text/javascript" } }],
					"request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"I tried clearing the cache but the problem persists.\",\n  \"isInternal\": false\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "comments"] } }
				},
				{ "name": "Get Comments", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "comments"] } } },
				{ "name": "Update Comment", "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"content\": \"Updated comment content here.\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments/{{commentId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "comments", "{{commentId}}"] } } },
				{ "name": "Delete Comment", "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/tickets/{{ticketId}}/comments/{{commentId}}", "host": ["{{baseUrl}}"], "path": ["tickets", "{{ticketId}}", "comments", "{{commentId}}"] } } }
			]
		},
		{
			"name": "Admin",
			"item": [
				{ "name": "Dashboard Stats", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/dashboard", "host": ["{{baseUrl}}"], "path": ["admin", "dashboard"] } } },
				{ "name": "Get All Tickets", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/tickets?page=1&limit=15&status=open&priority=high", "host": ["{{baseUrl}}"], "path": ["admin", "tickets"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "15" }, { "key": "status", "value": "open" }, { "key": "priority", "value": "high" }] } } },
				{ "name": "Update Ticket Status", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"status\": \"in-progress\",\n  \"note\": \"Assigned to technical team for investigation.\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/admin/tickets/{{ticketId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "tickets", "{{ticketId}}", "status"] } } },
				{ "name": "Update Ticket Priority", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "raw", "raw": "{\n  \"priority\": \"critical\"\n}", "options": { "raw": { "language": "json" } } }, "url": { "raw": "{{baseUrl}}/admin/tickets/{{ticketId}}/priority", "host": ["{{baseUrl}}"], "path": ["admin", "tickets", "{{ticketId}}", "priority"] } } },
				{ "name": "Get All Users", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/admin/users?page=1&limit=15", "host": ["{{baseUrl}}"], "path": ["admin", "users"], "query": [{ "key": "page", "value": "1" }, { "key": "limit", "value": "15" }] } } }
			]
		},
		{
			"name": "Activity",
			"item": [
				{ "name": "Get Activities", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/activities?limit=50", "host": ["{{baseUrl}}"], "path": ["activities"], "query": [{ "key": "limit", "value": "50" }] } } },
				{ "name": "Get Ticket Activity", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": { "raw": "{{baseUrl}}/activities/ticket/{{ticketId}}", "host": ["{{baseUrl}}"], "path": ["activities", "ticket", "{{ticketId}}"] } } }
			]
		}
	]
}
